# Hosting ke Environment Variables mein ye daalo (key ko kabhi code/zip mein mat likho)
NODE_ENV=production
APP_URL=https://tumhara-domain.com
SESSION_SECRET=koi-lamba-random-text
DATA_DIR=/data

# Provider API (gkpsmm.in)
SMM_API_URL=https://gkpsmm.in/api/v2
SMM_API_KEY=<yahan apni API key>
MARKUP_PERCENT=30

# Admin account (balance add karne ke liye /admin). Har restart par ye password set ho jata hai.
ADMIN_USERNAME=bksmm_admin
ADMIN_PASSWORD=<mazboot password>
ADMIN_EMAIL=<admin ka gmail>

# Gmail se password-reset mail
SMTP_USER=tumhara@gmail.com
SMTP_PASS=<gmail app password>

# Google signup
GOOGLE_CLIENT_ID=
